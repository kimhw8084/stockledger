# Optional personal cloud sync. Leave blank for the complete local workspace.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public API URL reserved for a future managed market-data gateway.
# The current CSV/local worker does not require this.
EXPO_PUBLIC_STOCKLEDGER_API_URL=

# Never put provider secrets, database passwords, or service-role keys in
# EXPO_PUBLIC_* values. Public configuration is embedded during Expo builds.
