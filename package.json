{
  "name": "stockledger",
  "version": "0.2.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "export:web": "EXPO_NO_DOTENV=1 expo export --platform web",
    "worker": "tsx server/worker/cli.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:e2e": "playwright test",
    "test:cloud": "tsx tests/integration/cloud.integration.ts",
    "export:all": "EXPO_NO_DOTENV=1 expo export --platform all",
    "preview": "node scripts/serve-preview.mjs",
    "benchmark:worker": "tsx scripts/benchmark-worker.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@noble/hashes": "2.4.0",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@supabase/supabase-js": "2.116.0",
    "expo": "^57.0.23",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.20",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "2.0.0",
    "react-native-web": "^0.21.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/react": "~19.2.4",
    "@types/react-dom": "19.2.3",
    "fake-indexeddb": "6.2.5",
    "supabase": "2.117.0",
    "tsx": "4.23.13",
    "typescript": "~6.0.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
