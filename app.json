{
  "expo": {
    "name": "StockLedger",
    "slug": "stockledger",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing"
    ]
  }
}
